{
  "identityProviders": {
    "azureActiveDirectory": {
      "login": {
        "loginParameters": [
          "scope=openid profile email offline_access api://<BFF_API_CLIENT_ID>/Workspace.Web.Access"
        ]
      }
    }
  },
  "login": {
    "tokenStore": {
      "enabled": true,
      "azureBlobStorage": {
        "blobContainerUri": "https://<TOKEN_STORE_ACCOUNT>.blob.core.windows.net/<PRIVATE_CONTAINER>",
        "managedIdentityResourceId": "<WEB_TOKEN_STORE_USER_ASSIGNED_IDENTITY_RESOURCE_ID>"
      }
    }
  }
}
