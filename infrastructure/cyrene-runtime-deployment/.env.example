# =============================================================================
# CY-LLM Engine - environment variables
# =============================================================================

CY_LLM_ENGINE=cuda-vllm
CY_LLM_LITE_PORT=8000
CY_LLM_LITE_WORKER_PORT=50052
CY_LLM_CONDA_ENV=vllm
CY_LLM_PYTHON_VERSION=3.12
CY_LLM_MODEL=default
CY_LLM_MODEL_CACHE=~/.cache/cy-llm/models
CY_LLM_CHECKPOINT_DIR=~/.cache/cy-llm/checkpoints
VLLM_TP=1
VLLM_GPU_MEM=0.9

# Set a strong value outside local development.
CY_LLM_INTERNAL_TOKEN=change-me
CY_LLM_ENV=development
CY_LLM_ALLOW_INSECURE_INTERNAL_TOKEN=false
