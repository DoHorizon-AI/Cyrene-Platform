# Build context: repository root.
# BASE_IMAGE must provide a compatible Python runtime and CUDA/vLLM runtime.

ARG BASE_IMAGE=vllm/vllm-openai:v0.12.0
FROM ${BASE_IMAGE}

ARG CUDA_TAG=124

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN if command -v apt-get >/dev/null 2>&1; then \
      apt-get update \
      && apt-get install -y --no-install-recommends curl ca-certificates git \
      && rm -rf /var/lib/apt/lists/*; \
    fi

RUN uv python install 3.12 \
    && uv venv --python 3.12 /opt/venv

ENV PATH="/opt/venv/bin:${PATH}"

WORKDIR /app

# Install the current repository runtime and Pro extension. The legacy
# external Worker tree is deliberately not copied into this image.
COPY plugins/docker-uv-builder/legacy-requirements/requirements-base.txt plugins/docker-uv-builder/legacy-requirements/requirements-vllm.txt ./
RUN sed "s#cu124#cu${CUDA_TAG}#g" requirements-vllm.txt > requirements-vllm.generated.txt \
    && uv pip install --python /opt/venv/bin/python -r requirements-vllm.generated.txt

COPY services/cyrene-reactor/runtime/core ./services/cyrene-reactor/runtime/core
COPY services/cyrene-reactor/runtime/pro ./services/cyrene-reactor/runtime/pro
COPY plugins/cy-plugin-spring-gateway/proto ./proto
COPY infrastructure/cyrene-runtime-deployment/enterprise/models.json /etc/cy-llm-pro/models.json

# Refresh the generated Community bindings from the canonical root proto.
RUN python -m grpc_tools.protoc \
      -I./proto \
      --python_out=./services/cyrene-reactor/runtime/core/src/cy_exec/proto \
      --grpc_python_out=./services/cyrene-reactor/runtime/core/src/cy_exec/proto \
      ./proto/ai_service.proto \
    && touch ./services/cyrene-reactor/runtime/core/src/cy_exec/proto/__init__.py \
    && sed -i 's/^import ai_service_pb2/from . import ai_service_pb2/' \
      ./python/cy_exec/src/cy_exec/proto/ai_service_pb2_grpc.py \
    && uv pip install --python /opt/venv/bin/python ./services/cyrene-reactor/runtime/core ./services/cyrene-reactor/runtime/pro

RUN mkdir -p /models /checkpoints /etc/cy-llm-pro

ENV CY_LLM_BACKEND=cuda-vllm \
    CY_LLM_MODEL_REGISTRY_PATH=/etc/cy-llm-pro/models.json \
    CY_LLM_HEALTH_PORT=9090

EXPOSE 50051 9090

CMD ["python", "-m", "cy_exec.main", "--serve", "--port", "50051", "--registry", "/etc/cy-llm-pro/models.json"]
