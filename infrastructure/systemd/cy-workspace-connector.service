[Unit]
Description=CYRENE Workspace Connector Host
After=network-online.target cyrene-runtime-maintenance.service
Wants=network-online.target
Requires=cyrene-runtime-maintenance.service

[Service]
Type=simple
User=cyrene
Group=cyrene
EnvironmentFile=-/etc/cyrene/workspace-connector.env
ExecStart=/usr/bin/cyrene component-run cy-workspace-connector --
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
