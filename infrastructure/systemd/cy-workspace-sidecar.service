[Unit]
Description=CYRENE Workspace Sidecar Host
After=local-fs.target cyrene-runtime-maintenance.service
Requires=cyrene-runtime-maintenance.service

[Service]
Type=simple
User=cyrene
Group=cyrene
EnvironmentFile=-/etc/cyrene/workspace-sidecar.env
ExecStart=/usr/bin/cyrene component-run cy-workspace-sidecar --
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
