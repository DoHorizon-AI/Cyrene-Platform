[Unit]
Description=Cyrene Workspace Authority Host
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cyrene
Group=cyrene
SupplementaryGroups=cyrene-authority cyrene-product-bundle-reader
EnvironmentFile=/etc/cyrene/workspace-authority.env
EnvironmentFile=/etc/cyrene/workspace-authority-identity.env
Environment=CYRENE_WORKSPACE_AUTHORITY_BFF_UDS=/run/cyrene-workspace-authority/bff/bff.sock
Environment=CYRENE_AUTHORITY_ADMIN_PEER_UID=0
ExecStart=/usr/lib/cyrene/components/cy-workspace-authority-host
Restart=on-failure
RestartSec=2s
StateDirectory=cyrene-workspace-authority
StateDirectoryMode=0700
RuntimeDirectory=cyrene-workspace-authority
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/cyrene-workspace-authority /run/cyrene-workspace-authority
ReadOnlyPaths=/var/lib/cyrene-product-bundles /etc/cyrene-workspace-authority
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
