[Unit]
Description=CYRENE Rust Node Kernel
After=local-fs.target cyrene-sandboxd.service cyrene-linux-sys-adapter.service
Requires=cyrene-sandboxd.service cyrene-linux-sys-adapter.service

[Service]
Type=simple
User=cyrene-kernel
Group=cyrene
# Each deployment supplies one or more generic UDS adapters. This example
# registers the required Linux System Adapter and NVIDIA Sidecar; AMD/Ascend/
# custom hardware adapters use the same flag.
#
# Peer-credential admission is FAIL-CLOSED: cyrene-kernel refuses to start
# unless every Adapter endpoint is configured with at least one trusted peer
# UID/GID. The values below identify the Adapter processes that may connect
# back to the Kernel:
#   * sandboxd and the NVIDIA adapter run as root (uid 0) in the unit files
#     below, in the `cyrene` group. Replace `0`/`992` with the actual
#     service-account IDs (`id -u cyrene-sandboxd`, `getent group cyrene`).
#   * The matching `--allowed-client-uid`/`--allowed-client-gid` on the Adapter
#     units must equal THIS service's identity (cyrene-kernel uid / cyrene gid;
#     example 991/992 -> `id -u cyrene-kernel`, `getent group cyrene`).
#   See docs/operations/kernel-runtime.md for the full service-account UID/GID
#   deployment example.
ExecStart=/usr/bin/cyrene-kernel --socket /run/cyrene/kernel.sock --sandbox-adapter sandboxd=/run/cyrene/sandboxd.sock --sandbox-adapter-peer-uid sandboxd=0 --sandbox-adapter-peer-gid sandboxd=992 --system-adapter linux-system=/run/cyrene/linux-sys-adapter.sock --system-adapter-peer-uid linux-system=0 --system-adapter-peer-gid linux-system=992 --hardware-adapter nvidia=/run/cyrene/nvidia-adapter.sock --hardware-adapter-peer-uid nvidia=0 --hardware-adapter-peer-gid nvidia=992 --runtime-journal /var/lib/cyrene/runtime/journal.jsonl
Restart=on-failure
RestartSec=2s
RuntimeDirectory=cyrene
RuntimeDirectoryMode=0750
StateDirectory=cyrene
StateDirectoryMode=0750
UMask=0007

# Kernel never owns workers or a cgroup delegation. `cyrene-sandboxd` owns the
# delegated subtree and worker fate; this service contains only safe decisions
# and local UDS clients. The `cyrene` group is the explicit trust boundary for
# sandboxd, hardware adapters, and the external Node Agent; never add Workers.
KillMode=process
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/cyrene /var/lib/cyrene

[Install]
WantedBy=multi-user.target
