# Build context: repository root.
# The Gradle image supplies the build tool; no Gradle wrapper is required.

FROM gradle:8.10-jdk21 AS builder

WORKDIR /workspace
COPY plugins/cy-plugin-spring-gateway ./plugins/cy-plugin-spring-gateway

WORKDIR /workspace/plugins/cy-plugin-spring-gateway
RUN gradle --no-daemon --build-cache bootJar -x test

FROM eclipse-temurin:21-jre

LABEL org.opencontainers.image.title="CY-LLM Pro Gateway"
LABEL org.opencontainers.image.description="Optional Pro Kotlin enterprise gateway"

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system cyllm \
    && useradd --system --gid cyllm --home-dir /nonexistent --shell /usr/sbin/nologin cyllm

WORKDIR /app
COPY --from=builder /workspace/plugins/cy-plugin-spring-gateway/build/libs/*.jar /app/app.jar
COPY infrastructure/cyrene-runtime-deployment/enterprise/models.json /etc/cy-llm-pro/models.json

RUN chown -R cyllm:cyllm /app /etc/cy-llm-pro
USER cyllm

ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+UseG1GC"
ENV CY_LLM_MODEL_REGISTRY_PATH=/etc/cy-llm-pro/models.json

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -fsS http://localhost:8080/actuator/health || exit 1

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar"]
