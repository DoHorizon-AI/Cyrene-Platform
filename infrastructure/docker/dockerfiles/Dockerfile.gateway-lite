FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app
COPY python/cy_exec ./python/cy_exec
COPY python/cy_gateway_lite ./python/cy_gateway_lite

RUN uv pip install --system --no-cache ./python/cy_exec \
    && uv pip install --system --no-cache ./python/cy_gateway_lite

ENV PYTHONUNBUFFERED=1
EXPOSE 8000

CMD ["uvicorn", "cy_gateway_lite.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
