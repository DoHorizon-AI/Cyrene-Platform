FROM python:3.12-slim

# A0 baseline image: engine-specific CUDA/vLLM dependencies are built by M4.

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app
COPY python/cy_exec ./python/cy_exec
COPY deploy/models.json ./deploy/models.json

RUN uv pip install --system --no-cache ./python/cy_exec

ENV PYTHONUNBUFFERED=1
ENV CY_LLM_MODEL_REGISTRY_PATH=/app/deploy/models.json
EXPOSE 50052 9090

CMD ["python", "-m", "cy_exec.main", "--serve"]
