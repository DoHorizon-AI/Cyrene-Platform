# Build with the Cyrene-Platform repository root as context.
FROM rust:1.96.1-slim-bookworm AS build

RUN apt-get update \
    && apt-get install --yes --no-install-recommends pkg-config libssl-dev perl make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /source
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY contracts contracts
COPY kernel kernel
COPY framework framework
COPY runtime runtime
COPY agents agents
COPY adapters adapters
COPY sdk/rust sdk/rust

RUN cargo build --locked --release -p cy-runtime-maintenance --bin cyrene-runtime-maintenance

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/* \
    && install -d -o 0 -g 0 -m 0755 /etc/cyrene /run/cyrene /var/lib/cyrene/runtime

COPY --from=build /source/target/release/cyrene-runtime-maintenance /usr/local/bin/cyrene-runtime-maintenance

ENTRYPOINT ["/usr/local/bin/cyrene-runtime-maintenance"]
