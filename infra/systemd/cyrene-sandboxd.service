[Unit]
Description=CYRENE Privileged Sandbox Adapter Host
After=local-fs.target
RequiresMountsFor=/sys/fs/cgroup
# A deliberate Kernel stop/restart also stops this host, which removes every
# delegated worker cgroup instead of allowing the next Kernel epoch to adopt it.
PartOf=cyrene-kernel.service

[Service]
Type=simple
User=root
Group=cyrene
# Fail-closed UDS admission: sandboxd refuses to start without at least one
# trusted Kernel peer identity. The values must equal the cyrene-kernel service
# account (example uid 991 / cyrene gid 992 -> `id -u cyrene-kernel`,
# `getent group cyrene`). The Kernel, in turn, asserts THIS process via
# `--sandbox-adapter-peer-uid sandboxd=0 --sandbox-adapter-peer-gid sandboxd=992`
# in cyrene-kernel.service.
ExecStart=/usr/bin/cyrene-sandboxd --adapter-id sandboxd --socket /run/cyrene/sandboxd.sock --allowed-client-uid 991 --allowed-client-gid 992
Restart=on-failure
RestartSec=2s
RuntimeDirectory=cyrene
RuntimeDirectoryMode=0750
UMask=0007

# sandboxd is the sole owner of the worker process tree and cgroup subtree.
# It receives the only cgroup delegation; do not grant it to cyrene-kernel.
KillMode=control-group
Delegate=cpu cpuset memory pids
TasksMax=infinity
MemoryAccounting=yes
CPUAccounting=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/cyrene

[Install]
WantedBy=multi-user.target
