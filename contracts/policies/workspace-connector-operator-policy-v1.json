{
  "schemaVersion": "cyrene.workspace.connector-operator-policy.v1",
  "operatorRole": "navigator.connector.operator.v1",
  "identity": {
    "issuer": "https://login.microsoftonline.com/<configured-tenant-id>/v2.0",
    "subjectClaim": "aadObjectId",
    "subjectFormat": "lowercase-uuid"
  },
  "grant": {
    "rpc": "cyrene.workspace.authority.v2.WorkspaceConnectorAuthorizationService/AuthorizeConnectorOperation",
    "audience": "exchange",
    "maximumTtlSeconds": 15,
    "signatureAlgorithm": "Ed25519",
    "signatureDomain": "cyrene.workspace.authority.v2/connector-operation-grant",
    "canonicalization": "deterministic-protobuf-with-grant-ref-and-signature-cleared"
  },
  "requiredScopeFields": [
    "organization_id",
    "workspace_id",
    "principal_issuer",
    "principal_subject",
    "connection_ref",
    "provider_id",
    "profile_ref",
    "operation_id",
    "resource_ref",
    "arguments_digest_sha256",
    "request_id"
  ],
  "operations": [
    { "operationId": "cloud.operation.cancel", "providerIds": ["azure", "gcp", "runpod"] },
    { "operationId": "cloud.operation.logs.read", "providerIds": ["azure", "gcp", "runpod"] },
    { "operationId": "cloud.operation.status.read", "providerIds": ["azure", "gcp", "runpod"] },
    { "operationId": "cloud.provider.health.read", "providerIds": ["azure", "gcp", "runpod"] },
    { "operationId": "cloud.resource.create", "providerIds": ["azure", "gcp", "runpod"] },
    { "operationId": "cloud.resource.delete", "providerIds": ["azure", "gcp", "runpod"] },
    { "operationId": "cloud.resource.deploy", "providerIds": ["azure", "gcp", "runpod"] },
    { "operationId": "cloud.resource.get", "providerIds": ["azure", "gcp", "runpod"] },
    { "operationId": "cloud.resource.restart", "providerIds": ["runpod"] },
    { "operationId": "cloud.resource.start", "providerIds": ["azure", "gcp", "runpod"] },
    { "operationId": "cloud.resource.stop", "providerIds": ["azure", "gcp", "runpod"] },
    { "operationId": "cloud.resource.update", "providerIds": ["azure", "gcp", "runpod"] },
    { "operationId": "cloud.resources.list", "providerIds": ["azure", "gcp", "runpod"] },
    { "operationId": "cloud.vendor.cli.execute", "providerIds": ["azure", "gcp", "runpod"] },
    { "operationId": "computer.command.execute", "providerIds": ["computer"] },
    { "operationId": "computer.directory.list", "providerIds": ["computer"] },
    { "operationId": "computer.file.read", "providerIds": ["computer"] },
    { "operationId": "computer.file.write", "providerIds": ["computer"] },
    { "operationId": "github.actions.job.logs.read", "providerIds": ["github"] },
    { "operationId": "github.actions.jobs.list", "providerIds": ["github"] },
    { "operationId": "github.actions.rerun_failed", "providerIds": ["github"] },
    { "operationId": "github.actions.runs.list", "providerIds": ["github"] },
    { "operationId": "github.branch.create", "providerIds": ["github"] },
    { "operationId": "github.branch.delete", "providerIds": ["github"] },
    { "operationId": "github.branch.get", "providerIds": ["github"] },
    { "operationId": "github.branches.list", "providerIds": ["github"] },
    { "operationId": "github.ci.status", "providerIds": ["github"] },
    { "operationId": "github.file.commit", "providerIds": ["github"] },
    { "operationId": "github.file.get", "providerIds": ["github"] },
    { "operationId": "github.issue.comment.create", "providerIds": ["github"] },
    { "operationId": "github.issue.get", "providerIds": ["github"] },
    { "operationId": "github.issue.state.update", "providerIds": ["github"] },
    { "operationId": "github.issues.search", "providerIds": ["github"] },
    { "operationId": "github.pull_request.draft.create", "providerIds": ["github"] },
    { "operationId": "github.pull_request.draft.find", "providerIds": ["github"] },
    { "operationId": "github.pull_request.get", "providerIds": ["github"] },
    { "operationId": "github.pull_requests.list", "providerIds": ["github"] },
    { "operationId": "github.repository.get", "providerIds": ["github"] },
    { "operationId": "github.repository.list", "providerIds": ["github"] },
    { "operationId": "github.vendor.cli.execute", "providerIds": ["github"] },
    { "operationId": "huggingface.datasets.list", "providerIds": ["huggingface"] },
    { "operationId": "huggingface.file.download", "providerIds": ["huggingface"] },
    { "operationId": "huggingface.file.upload", "providerIds": ["huggingface"] },
    { "operationId": "huggingface.models.list", "providerIds": ["huggingface"] },
    { "operationId": "huggingface.repo.get", "providerIds": ["huggingface"] },
    { "operationId": "huggingface.spaces.list", "providerIds": ["huggingface"] },
    { "operationId": "huggingface.vendor.cli.execute", "providerIds": ["huggingface"] },
    { "operationId": "msteams.message.reply", "providerIds": ["msteams"] }
  ]
}
