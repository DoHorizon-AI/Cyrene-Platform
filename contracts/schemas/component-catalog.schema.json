{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyrene.dev/schemas/component-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogVersion", "authority", "components"],
  "properties": {
    "catalogVersion": { "const": "1.0" },
    "authority": { "const": "docs/contracts/platform-component-boundary-v1.md" },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "id", "class", "state"],
        "properties": {
          "path": { "type": "string", "pattern": "^(services|plugins)/[a-z0-9-]+$" },
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
          "class": { "enum": ["platform", "adapter-host", "capability-plugin", "service", "service-bundle", "infrastructure-asset", "compatibility-snapshot"] },
          "state": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
