{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cyrene.dev/platform/workspace-product-policy.v2.schema.json",
  "title": "Cyrene Workspace Product authorization policy v2",
  "description": "Platform-owned authorization and mandatory scope-binding policy. Product catalogs cannot grant roles or remove these bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyVersion", "grants"],
  "properties": {
    "schemaVersion": { "const": "cyrene.workspace.product.authorization-policy.v2" },
    "policyVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "grants": {
      "type": "array",
      "items": { "$ref": "#/$defs/grant" }
    }
  },
  "$defs": {
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerId",
        "operationId",
        "principalKinds",
        "requiredRoles",
        "requiresExactWorkspace",
        "requiredRequestBindings",
        "requiredResponseBindings"
      ],
      "properties": {
        "ownerId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
        "operationId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "principalKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["DIRECTORY_USER", "TRUSTED_NAVIGATOR_WORKLOAD"] }
        },
        "requiredRoles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "requiresExactWorkspace": { "const": true },
        "requiredRequestBindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonScopeBinding" },
          "uniqueItems": true
        },
        "requiredResponseBindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonScopeBinding" },
          "uniqueItems": true
        }
      }
    },
    "jsonScopeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonPointer", "matches"],
      "properties": {
        "jsonPointer": { "type": "string", "pattern": "^/", "maxLength": 1024 },
        "matches": { "enum": ["ORGANIZATION_ID", "WORKSPACE_ID", "RESOURCE_ID"] }
      }
    }
  }
}
