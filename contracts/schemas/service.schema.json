{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyrene.dev/schemas/service.schema.json",
  "title": "CYRENE Service Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["service"],
  "properties": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "platform_contract", "artifact_class"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "platform_contract": { "type": "string", "minLength": 1 },
        "artifact_class": { "const": "service" },
        "public_api_contracts": { "type": "array", "items": { "type": "string" } },
        "required_capabilities": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*\\.v[0-9]+$" } },
        "dashboard": { "type": "boolean" },
        "kernel_access": { "const": "control-plane-mediated" },
        "status": { "type": "string" }
      }
    }
  }
}
