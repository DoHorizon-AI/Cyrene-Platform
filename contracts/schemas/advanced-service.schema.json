{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyrene.dev/schemas/advanced-service.schema.json",
  "title": "CYRENE advanced service manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "service", "visibility", "distribution", "status", "core", "source_roots"],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "id": { "type": "string", "pattern": "^com\\.cyrene\\.service\\.[a-z][a-z0-9-]*$" },
    "name": { "type": "string" },
    "service": {
      "type": "string",
      "enum": ["catalyst", "yield", "reactor", "exchange", "navigator", "echo"]
    },
    "visibility": { "type": "string", "enum": ["private"] },
    "distribution": { "type": "string", "enum": ["advanced-service-plugin"] },
    "status": { "type": "string", "enum": ["preserved-source", "adapting", "validated", "training-migrated", "migrated-runtime"] },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "minimum_core_version", "extension_points"],
      "properties": {
        "protocol_version": { "type": "integer", "enum": [1] },
        "minimum_core_version": { "type": "string" },
        "extension_points": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "planned_extension_points": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "source_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "migration": { "type": "object" },
    "runtime": { "type": "object" }
  }
}
