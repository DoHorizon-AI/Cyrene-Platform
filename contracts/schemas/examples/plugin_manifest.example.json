{
  "plugin": {
    "id": "com.cyrene.reference.nvidia",
    "name": "reference-nvidia",
    "version": "0.1.0",
    "api_version": "1.0",
    "kind": "probe",
    "edition": "community",
    "runtime": "subprocess-python",
    "license_gate": false,
    "entrypoint": "reference_probe:main",
    "author": "CYRENE",
    "description": "Reference NVIDIA inventory probe",
    "license": "Apache-2.0",
    "source_target": "core-reference",
    "status": "stable",
    "protocol_version": 1,
    "scope": "target",
    "restart_policy": "on-failure"
  },
  "capabilities": {
    "supported_hardware": ["nvidia", "cuda"],
    "supported_precisions": ["fp16", "bf16"],
    "supported_quantizations": ["none"],
    "supports_streaming": false,
    "features": ["inventory"]
  },
  "dependencies": {
    "required_plugins": ["com.cyrene.base"],
    "optional_plugins": ["com.cyrene.telemetry"],
    "conflicts": ["com.cyrene.legacy-probe"],
    "required_capabilities": ["nvidia-smi"],
    "system_dependencies": ["nvidia-smi"],
    "python_packages": []
  },
  "launch": {
    "executable": "python",
    "args": ["-m", "reference_probe"],
    "transport": "stdio",
    "startup_timeout_ms": 10000,
    "shutdown_timeout_ms": 5000
  },
  "permissions": {
    "filesystem_read": ["/proc", "/sys"],
    "filesystem_write": [],
    "network": [],
    "gpu": true,
    "process_spawn": false
  },
  "resources": {
    "memory_mb": 256,
    "max_message_bytes": 1048576
  },
  "package": {
    "sha256": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "signature": "sigstore:reference",
    "target_os": ["linux"],
    "target_arch": ["x86_64", "aarch64"]
  }
}
