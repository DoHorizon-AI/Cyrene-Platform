{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cy-llm.dev/schemas/manifests/model_manifest.schema.json",
  "$comment": "MIGRATING_COMPATIBILITY: implemented v0 model-analysis projection; frozen pending plugin or Product ownership.",
  "title": "ModelManifest",
  "description": "Deterministic description of a model's architecture, footprint and runtime requirements. Produced by the ModelAnalyzer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "architecture",
    "params",
    "weight_precision",
    "context_length",
    "format",
    "remote_code",
    "tokenizer",
    "vram_estimate"
  ],
  "properties": {
    "architecture": { "type": "string", "description": "Model architecture, e.g. 'Qwen2ForCausalLM'." },
    "params": { "type": "integer", "minimum": 0, "description": "Total parameter count (absolute, e.g. 7615616512)." },
    "weight_precision": {
      "type": "string",
      "description": "Native weight precision.",
      "enum": ["fp32", "fp16", "bf16", "fp8", "int8", "int4"]
    },
    "context_length": { "type": "integer", "minimum": 1, "description": "Maximum context length in tokens." },
    "format": {
      "type": "string",
      "description": "On-disk weight format.",
      "enum": ["safetensors", "pytorch", "gguf", "awq", "gptq", "onnx"]
    },
    "remote_code": { "type": "boolean", "description": "Whether the model requires trust_remote_code=True." },
    "tokenizer": { "type": "string", "description": "Tokenizer identifier/class, e.g. 'Qwen2Tokenizer'." },
    "chat_template": { "type": "string", "description": "Chat/prompt template identifier or inline template (optional)." },
    "quantization": {
      "type": "string",
      "description": "Quantization scheme applied to weights (optional).",
      "enum": ["none", "awq", "gptq", "bnb-nf4", "bnb-int8", "fp8"]
    },
    "vram_estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train_gb", "infer_gb"],
      "properties": {
        "train_gb": { "type": "number", "minimum": 0, "description": "Estimated VRAM for training in GiB." },
        "infer_gb": { "type": "number", "minimum": 0, "description": "Estimated VRAM for inference in GiB." }
      }
    }
  }
}
