{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cy-llm.dev/schemas/manifests/workload_request.schema.json",
  "title": "WorkloadRequest",
  "description": "A user's request describing what to run and under which objective/constraints. Input to the CompatibilityResolver / RuntimeBuilder.",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "workload", "objective", "constraints"],
  "properties": {
    "model": { "type": "string", "description": "Model reference, e.g. 'Qwen/Qwen2.5-7B'." },
    "workload": {
      "type": "string",
      "description": "Kind of workload to run.",
      "enum": ["finetune", "serve"]
    },
    "dataset": { "type": "string", "description": "Dataset reference/path (required in practice for finetune; optional here)." },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority"],
      "properties": {
        "priority": {
          "type": "string",
          "description": "Optimization priority guiding candidate selection.",
          "enum": ["latency", "throughput", "cost", "quality"]
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_gpu_count"],
      "properties": {
        "max_gpu_count": { "type": "integer", "minimum": 1, "description": "Maximum number of GPUs the workload may use." },
        "max_cost": { "type": "number", "minimum": 0, "description": "Maximum cost budget (currency-agnostic units, optional)." }
      }
    }
  }
}
