{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cy-llm.dev/schemas/manifests/hardware_manifest.schema.json",
  "$comment": "MIGRATING_COMPATIBILITY: implemented v0 AI hardware projection; new code uses the generic Node resource inventory contract.",
  "title": "HardwareManifest",
  "description": "Deterministic description of a target machine's hardware and platform capabilities. Produced by the HardwareAnalyzer / Node Agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "os",
    "cpu",
    "memory_gb",
    "disk_gb",
    "gpus",
    "driver_version",
    "cuda_max_supported",
    "interconnect",
    "precision_support"
  ],
  "properties": {
    "os": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kernel", "glibc"],
      "properties": {
        "name": { "type": "string", "description": "OS distribution/name, e.g. 'Ubuntu 22.04'." },
        "kernel": { "type": "string", "description": "Kernel release, e.g. '5.15.0-101-generic'." },
        "glibc": { "type": "string", "description": "glibc version, e.g. '2.35'." }
      }
    },
    "cpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arch", "cores"],
      "properties": {
        "arch": { "type": "string", "description": "CPU architecture, e.g. 'x86_64', 'aarch64'." },
        "cores": { "type": "integer", "minimum": 1, "description": "Physical core count." },
        "threads": { "type": "integer", "minimum": 1, "description": "Logical thread count (optional)." }
      }
    },
    "memory_gb": { "type": "number", "minimum": 0, "description": "Total system RAM in GiB." },
    "disk_gb": { "type": "number", "minimum": 0, "description": "Usable disk capacity in GiB." },
    "gpus": {
      "type": "array",
      "description": "Installed accelerators. Empty array means CPU-only.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "count", "vram_gb", "compute_capability"],
        "properties": {
          "model": { "type": "string", "description": "GPU model string, e.g. 'NVIDIA A100-SXM4-40GB'." },
          "count": { "type": "integer", "minimum": 1, "description": "Number of identical GPUs in this group." },
          "vram_gb": { "type": "number", "minimum": 0, "description": "Per-GPU VRAM in GiB." },
          "compute_capability": { "type": "string", "description": "CUDA compute capability, e.g. '8.0'." }
        }
      }
    },
    "driver_version": { "type": "string", "description": "GPU driver version, e.g. '550.90.07'." },
    "cuda_max_supported": { "type": "string", "description": "Maximum CUDA runtime the driver supports, e.g. '12.4'." },
    "interconnect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nvlink"],
      "properties": {
        "nvlink": { "type": "boolean", "description": "Whether NVLink is present between GPUs." },
        "pcie_gen": { "type": "integer", "minimum": 1, "description": "PCIe generation, e.g. 4 or 5 (optional)." }
      }
    },
    "precision_support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bf16", "fp16", "fp8"],
      "properties": {
        "bf16": { "type": "boolean" },
        "fp16": { "type": "boolean" },
        "fp8": { "type": "boolean" }
      }
    }
  }
}
