<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.27.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.67.0" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="../../../contracts/proto/cyrene/capability/v1/capability_execution.proto"
              ProtoRoot="../../../contracts/proto"
              GrpcServices="Client" />
    <Protobuf Include="../../../contracts/proto/cyrene/model/provider/v1/model_provider.proto"
              ProtoRoot="../../../contracts/proto"
              GrpcServices="None" />
  </ItemGroup>
</Project>
